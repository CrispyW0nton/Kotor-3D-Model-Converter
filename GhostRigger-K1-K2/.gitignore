# GhostRigger-K1-K2 .gitignore
# ─────────────────────────────

# ── Game data (large binary assets – not distributed in repo) ──────────────
# Set KOTOR_K1_DIR / KOTOR_K2_DIR env vars to point to your local game dirs.
game_data/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.spec

# ── Virtual environments ────────────────────────────────────────────────────
venv/
.venv/
env/

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Generated output (dev artifacts — don't commit these) ───────────────────
audit_output/
audit_reports/
render_stills_*/
render_test_output*/
render_test_output/
test_output/
/tmp/
*.tmp
*.log

# ── Test diagnostic images (generated by headless render tests) ─────────────
test_assets/diagnostics/
test_assets/*.png
test_assets/*.jpg
# (exception: keep the MDL/MDX/TGA game asset samples)
!test_assets/*.mdl
!test_assets/*.mdx
!test_assets/*.tga
!test_assets/*.json
!test_assets/honorguard/*.mdl
!test_assets/honorguard/*.mdx

# ── Random stray artefacts ───────────────────────────────────────────────────
*.png
# (exception: curated assets that live in assets/ only)
!assets/icons/*.ico
!assets/icons/*.png

# ── Secrets / local config ──────────────────────────────────────────────────
.env
.env.local
.env.*
secrets.py
local_config.py
config_local.py
