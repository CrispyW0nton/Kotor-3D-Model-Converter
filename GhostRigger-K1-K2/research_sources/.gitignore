# Exclude large binary test/asset files from research sources
# (source code files are kept for reference)

# Large binary game data
*.bif
*.bif
*.tlk
*.erf
*.mod
*.rim
*.key
*.mdx

# Large binary assets
*.psd
*.icns
*.tga
*.dds
*.bmp

# TTF/font files (large)
*.ttf
*.otf

# Test data directories  
**/test_files/
**/tests/test_data/

# Node.js build artifacts
**/node_modules/
**/dist/
**/.cache/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# C++ build artifacts
**/build/
**/*.o
**/*.a
**/*.lib
