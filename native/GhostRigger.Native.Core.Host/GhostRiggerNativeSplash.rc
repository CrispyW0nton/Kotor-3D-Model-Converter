#include <windows.h>
#include "Public/GhostRiggerNativeSplashResource.h"

IDI_GHOSTSTUDIO_APP_ICON ICON "../../assets/icons/ghostrigger.ico"

IDR_NATIVE_SPLASH_LOGO RCDATA "../../assets/icons/ghostrigger_1024x1024.png"
IDR_NATIVE_SPLASH_ICON_CHECK RCDATA "resources/svg/check.svg"
IDR_NATIVE_SPLASH_ICON_DOCUMENT RCDATA "resources/svg/document.svg"
IDR_NATIVE_SPLASH_ICON_GEAR RCDATA "resources/svg/gear.svg"
