<layout id="profile_animation" name="Visual Profile: Animation" version="1">
    <mainWindow width="1680" height="940" maximized="false"/>
    <toolbars>
        <toolbar id="main" visible="true" buttonMode="iconText" iconSize="18" height="40"/>
        <toolbar id="viewport" visible="true" buttonMode="textBesideIcon" iconSize="16" height="34"/>
    </toolbars>
    <panels>
        <panel id="contentBrowser" region="left" visible="true" minWidth="300" preferredWidth="430" minHeight="300" preferredHeight="520"/>
        <panel id="scene" region="left" visible="true" minWidth="240" preferredWidth="320" minHeight="170" preferredHeight="220"/>
        <panel id="library" region="left" visible="true" minWidth="280" preferredWidth="390"/>
        <panel id="modules" region="left" visible="true" minWidth="280" preferredWidth="390"/>
        <panel id="properties" region="right" visible="true" minWidth="300" preferredWidth="380"/>
        <panel id="animationLibrary" region="right" visible="true" minWidth="340" preferredWidth="440"/>
        <panel id="meshTools" region="right" visible="false" minWidth="260" preferredWidth="340"/>
        <panel id="nodes" region="left" visible="true" minWidth="260" preferredWidth="360"/>
        <panel id="lighting" region="right" visible="false" minWidth="320" preferredWidth="420"/>
        <panel id="cameras" region="right" visible="false" minWidth="340" preferredWidth="440"/>
        <panel id="moduleMeshes" region="right" visible="false" minWidth="360" preferredWidth="560"/>
        <panel id="adjustPivot" region="right" visible="false" minWidth="260" preferredWidth="320"/>
        <panel id="2das" region="left" visible="false" minWidth="420" preferredWidth="720"/>
        <panel id="resources" region="left" visible="false" minWidth="420" preferredWidth="720"/>
        <panel id="outputLog" region="bottom" visible="true" minHeight="120" preferredHeight="180"/>
        <panel id="pythonTerminal" region="bottom" visible="true" minHeight="120" preferredHeight="180"/>
    </panels>
    <dockLayout>
        <group id="libraryScene" area="left" mode="vertical" visible="true" active="content_browser">
            <dock id="scene"/>
            <dock id="content_browser"/>
        </group>
        <group id="animationInspector" area="right" mode="tabbed" visible="true" active="animations">
            <dock id="animations"/>
            <dock id="properties"/>
            <dock id="nodes"/>
        </group>
    </dockLayout>
    <viewport>
        <region id="mainViewport" minWidth="560" preferredWidth="900"/>
        <toolbar visible="true" buttonMode="textBesideIcon" compact="false"/>
    </viewport>
    <spacing>
        <margin value="4"/>
        <panelSpacing value="5"/>
        <toolbarSpacing value="4"/>
        <splitterHandleWidth value="8"/>
        <inputHeight value="26"/>
        <comboHeight value="26"/>
        <spinboxHeight value="26"/>
        <tabHeight value="14"/>
        <tabWidth value="88"/>
        <tabPadding value="8"/>
        <tabPaddingX value="12"/>
        <tabPaddingY value="6"/>
        <tabMargin value="0"/>
        <tabMarginX value="0"/>
        <tabMarginY value="0"/>
        <tableRowHeight value="23"/>
        <treeRowHeight value="23"/>
        <groupboxMargin value="8"/>
        <groupboxSpacing value="5"/>
        <panelHeaderHeight value="28"/>
        <viewportToolbarHeight value="34"/>
        <transformBarHeight value="30"/>
    </spacing>
</layout>
