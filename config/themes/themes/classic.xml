<theme id="classic" name="Classic" version="1">
    <metadata>
        <author>GhostRigger</author>
        <description>Traditional desktop-style theme with muted colours.</description>
        <mode>light</mode>
    </metadata>
    <colors>
        <color name="window.background" value="#ECE9D8"/>
        <color name="panel.background" value="#F7F5EA"/>
        <color name="panel.altBackground" value="#E6E2D0"/>
        <color name="panel.border" value="#A9A28B"/>
        <color name="viewport.background" value="#D8D4C6"/>
        <color name="viewport.border" value="#9E9888"/>
        <color name="viewport.text" value="#4F4A3E"/>
        <color name="toolbar.background" value="#E6E2D0"/>
        <color name="toolbar.border" value="#A9A28B"/>
        <color name="button.background" value="#F7F5EA"/>
        <color name="button.hover" value="#DDD7BD"/>
        <color name="button.checked" value="#3F6FA8"/>
        <color name="button.text" value="#1F1E1A"/>
        <color name="button.accentText" value="#FFFFFF"/>
        <color name="input.background" value="#FFFFFF"/>
        <color name="input.text" value="#1F1E1A"/>
        <color name="input.border" value="#A9A28B"/>
        <color name="selection.background" value="#3F6FA8"/>
        <color name="selection.text" value="#FFFFFF"/>
        <color name="text.primary" value="#1F1E1A"/>
        <color name="text.secondary" value="#5A5649"/>
        <color name="text.disabled" value="#8D8878"/>
        <color name="text.gold" value="#8A6E20"/>
        <color name="accent.primary" value="#3F6FA8"/>
        <color name="accent.secondary" value="#6B7F39"/>
        <color name="warning" value="#A36B00"/>
        <color name="error" value="#B43C3C"/>
        <color name="success" value="#2F7D46"/>
    </colors>
    <fonts>
        <font role="default" family="Segoe UI" size="9"/>
        <font role="monospace" family="Consolas" size="9"/>
        <font role="heading" family="Segoe UI" size="10" weight="bold"/>
    </fonts>
    <icons>
        <provider>qtawesome</provider>
        <defaultMode>textBesideIcon</defaultMode>
        <size role="toolbar" value="18"/>
        <size role="largeToolbar" value="24"/>
    </icons>
    <metrics>
        <metric name="toolbar.height" value="38"/>
        <metric name="toolbar.iconSize" value="18"/>
        <metric name="toolbar.spacing" value="5"/>
        <metric name="button.height" value="28"/>
        <metric name="button.minWidth" value="82"/>
        <metric name="button.paddingH" value="10"/>
        <metric name="button.paddingV" value="4"/>
        <metric name="panel.margin" value="5"/>
        <metric name="panel.spacing" value="5"/>
        <metric name="panel.minWidth" value="290"/>
        <metric name="panel.preferredWidth" value="380"/>
        <metric name="splitter.handleWidth" value="6"/>
        <metric name="bottom.preferredHeight" value="220"/>
        <metric name="bottom.minHeight" value="120"/>
        <metric name="viewport.minWidth" value="520"/>
        <metric name="border.radius" value="2"/>
    </metrics>
</theme>
