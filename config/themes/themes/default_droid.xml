        <color name="button.background" value="#4A4A4A"/>
        <color name="button.hover" value="#5B5B5B"/>
        <color name="button.pressed" value="#333333"/>
        <color name="button.checked" value="#00FF7A"/>
        <color name="button.text" value="#FFFFFF"/>
        <color name="button.checkedText" value="#00140A"/>
        <color name="button.accentText" value="#00140A"/>
        <color name="button.disabledBackground" value="#343434"/>
