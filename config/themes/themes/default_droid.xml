        <color name="panel.border" value="#505050"/>
        <color name="panel.headerBackground" value="#252525"/>
        <color name="panel.headerText" value="#F4F4F4"/>
        <color name="groupbox.border" value="#555555"/>
        <color name="groupbox.title" value="#00FF7A"/>
        <color name="viewport.background" value="#1B1B1B"/>
        <color name="viewport.border" value="#515151"/>
        <color name="viewport.gridMajor" value="#4E5A53"/>
        <color name="viewport.gridMinor" value="#39443E"/>
        <color name="viewport.text" value="#F0F0F0"/>
        <color name="viewport.helper.meshHover" value="#00D7B5"/>
