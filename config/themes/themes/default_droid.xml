<theme id="default_droid" name="Default Droid" version="1" highContrast="true">
    <metadata>
        <author>GhostRigger</author>
        <description>Default native UI geometry with Droid console colors.</description>
        <mode>dark</mode>
        <highContrast>true</highContrast>
    </metadata>
    <styles>
        <style name="application.paletteOnly" value="true"/>
        <style name="splash.surfaceStyle" value="matte"/>
    </styles>
    <colors>
        <color name="window.background" value="#1D1D1D"/>
        <color name="window.text" value="#F4F4F4"/>
        <color name="panel.background" value="#2E2E2E"/>
        <color name="panel.backgroundAlt" value="#3A3A3A"/>
