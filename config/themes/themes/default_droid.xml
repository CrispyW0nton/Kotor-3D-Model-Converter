        <color name="tab.selectedBackground" value="#2E2E2E"/>
        <color name="tab.text" value="#D8D8D8"/>
        <color name="tab.selectedText" value="#00FF7A"/>
        <color name="table.background" value="#242424"/>
        <color name="table.text" value="#F4F4F4"/>
        <color name="table.headerBackground" value="#383838"/>
        <color name="table.headerText" value="#FFFFFF"/>
