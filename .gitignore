# ── Tests ─────────────────────────────────────────────────────────────────────
# Contents of /tests/ are ignored by default (ad-hoc prototypes and pyc caches).
# Add a "!/tests/<name>.py" exception below for any test that should ship with
# the repo — same pattern as /tools/* / !/tools/model_inspector.py.  Using
# /tests/* instead of /tests/ so re-inclusion patterns resolve.
/tests/*
!/tests/__init__.py
!/tests/conftest.py
!/tests/test_core_contracts.py
!/tests/test_regression.py
!/tests/test_mcp_full_scan.py
!/tests/test_mcp_textures.py
!/tests/test_mcp_skinning.py
!/tests/test_qt_only_imports.py
!/tests/test_character_mode.py
test_assets/
pytest.ini
.pytest_cache/

